<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.guopeijun.daily-reader</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/guopeijun/.agents/skills/newspaper-fetch/scripts/fetch.py</string>
		<string>--stage</string>
		<string>fetched,parsed</string>
	</array>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key><integer>10</integer>
			<key>Minute</key><integer>25</integer>
		</dict>
		<dict>
			<key>Hour</key><integer>20</integer>
			<key>Minute</key><integer>0</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/guopeijun</string>
	<key>StandardOutPath</key>
	<string>/Users/guopeijun/Library/Logs/daily-reader.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/guopeijun/Library/Logs/daily-reader.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key><string>/Users/guopeijun</string>
		<key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>LANG</key><string>zh_CN.UTF-8</string>
	</dict>
</dict>
</plist>
